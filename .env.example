# =====================================================================
# grow-bot (Mujeeb) environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# The platform runs fully WITHOUT any keys using the built-in `mock`
# provider, so you can explore the whole flow before wiring real LLMs.
# =====================================================================

# Active LLM provider used as the global default when a bot does not
# override it. One of: mock | anthropic | openai | gemini
# Leave BLANK to auto-detect whichever provider key you set below
# (preferring Anthropic). Only set this to pin a specific vendor.
LLM_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude model)
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Where the file-backed dev store keeps its JSON (defaults to ./.data)
# DATA_DIR=.data

# =====================================================================
# Voice — "Maya" (Hume AI EVI). Required only for the premium Hume voice
# engine. Without these, the app falls back to key-free browser voice.
# Create an EVI config in the Hume dashboard and paste its ID below.
# =====================================================================
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_EVI_CONFIG_ID=

# --- Native Egyptian voice — ElevenLabs (the voice engine for Maya) ---
# Most natural / expressive Egyptian-Arabic TTS. Pick an Egyptian voice from
# the ElevenLabs Voice Library (e.g. "Fathy Hammad", "Maged Magdy"), add it to
# your account, and paste its Voice ID below. Model defaults to
# eleven_multilingual_v2 (set eleven_v3 for the most expressive output).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Azure Speech (legacy — NOT used; kept for reference only) ---
# The app's voice engine is ElevenLabs above. These vars are ignored.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=ar-EG-SalmaNeural
