# =====================================================================
# Grow-Chatbot (Mujeeb) environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# The platform runs fully WITHOUT any keys using the built-in `mock`
# provider, so you can explore the whole flow before wiring real LLMs.
# =====================================================================

# Active LLM provider used as the global default when a bot does not
# override it. One of: mock | anthropic | openai | gemini
LLM_PROVIDER=mock

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude model)
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Where the file-backed dev store keeps its JSON (defaults to ./.data)
# DATA_DIR=.data
